# Database
# Default: SQLite (dev). Swap to PostgreSQL by setting:
#   DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/gym
DATABASE_URL=sqlite:///./gym.db

# JWT
JWT_SECRET=change-me-please-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# CORS - comma separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# Runtime
ENV=development

# Phase 9 — Voice Assistant (server-side only; never VITE_*)
# Leave OPENAI_API_KEY empty to disable interpretation. The rest of the app
# keeps working (typed/manual workout entry).
OPENAI_API_KEY=
ASSISTANT_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
ASSISTANT_TIMEOUT_SECONDS=20
ASSISTANT_MAX_COMMANDS=8
ASSISTANT_RATE_LIMIT_PER_MINUTE=20
